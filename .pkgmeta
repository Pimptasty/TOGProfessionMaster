package-as: TOGProfessionMaster

curseforge-project-id: 1513588

enable-toc-creation: no
enable-nolib-creation: yes

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

required-dependencies:
  - ace3
  - acecommqueue
  - versioncheck
  - deltasync
  - libguildroster
  - libprofessiondb
  - libitemdb

optional-dependencies:
  - togbankclassic
  - greenwall
  - auctionator
  - auctioneer
  - tradeskill-master
# Folders are bare names (no trailing slash) and globs are repo-relative with a
# single star -- see the BigWigs packager notes in ~/.claude/CLAUDE.md.
# Anything beginning with a dot (.git, .github, .vscode, .claude, .luarc.json,
# ...) is pruned by the packager automatically and must not be listed here.
ignore:
  - docs
  - tools
  - Tests
  - "*.ps1"
  - "*.bat"
  - "*.code-workspace"
  - "CLAUDE.md"
  - "CHANGELOG_ARCHIVE.md"
  - "conversation.md"
