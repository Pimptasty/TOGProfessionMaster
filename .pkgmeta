package-as: TOGProfessionMaster

curseforge-project-id: 1513588

enable-toc-creation: no
enable-nolib-creation: yes

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

required-dependencies:
  - ace3
  - acecommqueue
  - versioncheck
  - deltasync
  - libguildroster
  - libprofessiondb
  - libitemdb

optional-dependencies:
  - togbankclassic
  - greenwall
  - auctionator
  - auctioneer
  - tradeskill-master
ignore:
  - .git/
  - .github/
  - .vscode/
  - .claude/
  - docs/
  - tools/
  - "**/*.ps1"
  - "**/*.bat"
  - "*.code-workspace"
  - ".luarc.json"
  - ".markdownlint.json"
  - ".markdownlintignore"
  - "CLAUDE.md"
  - "CHANGELOG_ARCHIVE.md"
