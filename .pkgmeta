package-as: TOGProfessionMaster

curseforge-project-id: 1513588

enable-toc-creation: no
enable-nolib-creation: yes

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

required-dependencies:
  - ace3
  - acecommqueue
  - versioncheck
  - deltasync
  - libguildroster
  - libprofessiondb
  - libitemdb
  - libdbicon-1-0
  - libaceguiwidgets

optional-dependencies:
  - togbankclassic
  - greenwall
  - auctionator
  - auctioneer
  - tradeskill-master

ignore:
  - docs
  - tools
  - Tests
  - "*.ps1"
  - "*.bat"
  - "*.code-workspace"
  - "CLAUDE.md"
  - "CHANGELOG_ARCHIVE.md"
  - "conversation.md"
